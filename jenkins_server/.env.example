# Jenkins Server Configuration
# Copy to .env and fill in. NEVER commit .env.

# HTTP UI is bound to loopback; expose it via the nginx TLS vhost, not directly.
JENKINS_HTTP_BIND=127.0.0.1
JENKINS_HTTP_PORT=9090

# Agent port must be reachable by inbound JNLP agents.
JENKINS_AGENT_BIND=0.0.0.0
JENKINS_AGENT_PORT=50000

JENKINS_ADMIN_USER=admin
# REQUIRED. Generate one, do not reuse:
#   tr -dc 'A-Za-z0-9!@%^_+=-' </dev/urandom | head -c 32; echo
JENKINS_ADMIN_PASSWORD=

JENKINS_URL=https://jenkins.baldeaglegamehost.de
